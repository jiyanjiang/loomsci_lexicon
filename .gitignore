# ============================================================
# loomsci_lexicon .gitignore — 系统级分享边界
#
# 设计原则：
#   1. 只定义「不分享」——不删除任何文件（保留本地完整工作区）
#   2. 分享的 parquet 数据 = 前 5 年（1991-1995），其余年份一律排除
#   3. internal/ 目录 = 内部工具与产物，绝不分享（生图、T3 竞赛、私有脚本等）
#   4. 所有 API key / 个人配置一律排除
# ============================================================

# ---------- 敏感信息（绝不分享）----------
config.yaml                       # 本地真实配置（含 API key 与个人路径）
api-key.txt                       # 明文 key 文件（历史遗留）
*.key
*.pem
.fernet_key

# ---------- 内部工具 / 私有脚本 / 竞赛材料（绝不分享）----------
internal/                         # 内部目录：生图、竞赛、私有脚本
scripts/gen_headpic*.py           # 生图脚本（含 ARK key 常量，不分享）
scripts/predict_*.py              # 报告生成系列（内部使用）
scripts/review_*.py               # 评审脚本（内部使用）
scripts/ai4r_*.py                 # AI4R 竞赛脚本（内部使用）
scripts/write_ai4r_deepseek.py
scripts/stage_review_v4pro.py
scripts/fetch_real_papers.py      # 真实论文抓取（含 API 调用细节）
scripts/judge_phrases.py          # LLM 判读（内部）

# ---------- 环境 ----------
.venv/
venv/
__pycache__/
*.pyc
.DS_Store

# ---------- 数据（分享边界：只分享前 5 年 1991-1995）----------
